    "Opens the AI assistant panel for file analysis and conversation. Default is Cmd+Shift+A. Only works when screen assistant feature is enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel del asistente de IA para análisis de archivos y conversación. El atajo predeterminado es Cmd+Shift+A. Solo funciona cuando la función de asistente de pantalla está activada."
          }
        }
      }
    },
    "Opens the clipboard history panel. Default is Cmd+Shift+V (similar to Windows+V on PC). Only works when clipboard feature is enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel del historial del portapapeles. El atajo predeterminado es Cmd+Shift+V (similar a Windows+V en PC). Solo funciona cuando la función de portapapeles está activada."
          }
        }
      }
    },
    "Opens the color picker panel for screen color capture. Default is Cmd+Shift+P. Only works when color picker feature is enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel del selector de color para capturar tonos en pantalla. El atajo predeterminado es Cmd+Shift+P. Solo funciona cuando el selector está activado."
          }
        }
      }
    },
    "Opens the detailed system performance monitor panel. Default is Cmd+Shift+S. Only works when stats feature is enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel detallado del monitor de rendimiento del sistema. El atajo predeterminado es Cmd+Shift+S. Solo funciona cuando estadísticas está activado."
          }
        }
      }
    },
    "Panel mode shows clipboard in a floating window near the notch. Popover mode shows clipboard as a dropdown attached to the clipboard button.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo panel muestra el portapapeles en una ventana flotante junto al notch. El modo desplegable lo muestra como menú ligado al botón."
          }
        }
      }
    },
    "Panel mode shows color picker in a floating window. Popover mode shows color picker as a dropdown attached to the color picker button.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo panel muestra el selector en una ventana flotante. El modo desplegable lo muestra como menú ligado al botón de color."
          }
        }
      }
    },
    "Panel mode shows the assistant in a floating window near the notch. Popover mode shows the assistant as a dropdown attached to the AI button.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo panel muestra el asistente en una ventana flotante junto al notch. El modo desplegable lo muestra como menú ligado al botón de IA."
          }
        }
      }
    },
